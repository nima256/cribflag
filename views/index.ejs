<%
const normalizeHomeBadge = value => String(value || '')
  .toLowerCase()
  .replace(/[ي]/g, 'ی')
  .replace(/[ك]/g, 'ک')
  .replace(/[\u200c\u200d\u200e\u200f]/g, ' ')
  .replace(/\s+/g, ' ')
  .trim();
const specialBadgeNames = new Set(['ویژه', 'پیشنهاد ویژه'].map(normalizeHomeBadge));
const bestSellerBadgeNames = new Set(['پرفروش', 'پرفروش‌ترین', 'پرفروش ترین'].map(normalizeHomeBadge));
const markedSpecialProducts = products.filter(product => specialBadgeNames.has(normalizeHomeBadge(product.badge)));
const markedBestSellerProducts = products.filter(product => bestSellerBadgeNames.has(normalizeHomeBadge(product.badge)));
const homeSpecialProducts = (markedSpecialProducts.length ? markedSpecialProducts : products.slice(0, 4)).slice(0, 4);
const homeBestSellerProducts = (markedBestSellerProducts.length ? markedBestSellerProducts : products.slice(4, 12)).slice(0, 8);
%>
<section class="section">
<div class="section-head">
<div>
<h2 class="section-title">پیشنهادات ویژه</h2>
<p class="section-subtitle">محصولات پرطرفدار با قیمت مناسب برای خرید سریع.</p>
</div>
<button class="view-all" data-page-link="store">مشاهده همه ←</button>
</div>
<div class="products-grid" id="specialProducts"><% homeSpecialProducts.forEach(product => { %><%- include("partials/product-card", { product, toman }) %><% }) %></div>
</section>
<section class="section">
<div class="section-head">
<div>
<h2 class="section-title">دسته‌بندی محصولات</h2>
<p class="section-subtitle">سریع‌تر محصول مناسب خود را پیدا کنید.</p>
</div>
</div>
<div class="categories-grid">
<% (homeCategories || []).forEach(category => { %>
<a class="category-card store-category-link" data-category="<%= category.slug %>" href="/store?category=<%= encodeURIComponent(category.slug) %>">
<div class="category-card-media"><img alt="<%= category.name %>" height="800" src="<%= category.image || '/assets/images/ukflag.png' %>" width="800" loading="lazy" decoding="async"/></div>
<h3><%= category.name %></h3>
</a>
<% }) %>
<% if (!(homeCategories || []).length) { %><div class="results-empty"><div><h3>هنوز دسته‌بندی فعالی ثبت نشده است</h3><p>از پنل مدیریت، دسته‌بندی‌های صفحه اصلی را فعال کنید.</p></div></div><% } %>
</div>
</section>
<section class="section">
<div class="section-head">
<div>
<h2 class="section-title">پرفروش‌ترین‌ها</h2>
</div>
<div class="slider-floating-controls">
<button class="round-control best-prev">‹</button>
<button class="round-control best-next">›</button>
</div>
</div>
<div class="horizontal-slider" id="bestSellerSlider"><% homeBestSellerProducts.forEach(product => { %><%- include("partials/product-card", { product, toman }) %><% }) %></div>
</section>
