  const countBox = document.getElementById('accountReviewsCount');
  const modal = document.getElementById('reviewSubmitModal');
  const form = document.getElementById('reviewSubmitForm');
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const statusLabel = status => ({pending:'در انتظار تأیید',approved:'منتشر شده',rejected:'نیازمند ارسال مجدد'}[status] || status || '');
  const closeModal = () => modal?.classList.remove('cf-open');
  const reviewNav = document.querySelector('[data-account-view="reviews"]');
  const activateReviewView = () => {
    document.querySelectorAll('[data-account-section]').forEach(section => section.classList.toggle('active', section.dataset.accountSection === 'reviews'));
    document.querySelectorAll('[data-account-view]').forEach(button => button.classList.toggle('active', button.dataset.accountView === 'reviews'));
    const title = document.getElementById('accountViewTitle');
    if (title) title.textContent = 'رضایت خرید';
  };
  reviewNav?.addEventListener('click', activateReviewView);

  function openModal(item, orderNumber) {
    if (!modal) return;
    document.getElementById('reviewOrderNumber').value = orderNumber;
    document.getElementById('reviewProductId').value = item.productId;
    document.getElementById('reviewProductTitle').value = item.title;
    document.getElementById('reviewText').value = item.review?.status === 'rejected' ? (item.review.text || '') : '';
    document.getElementById('reviewImages').value = '';
    document.getElementById('reviewImagePreview').innerHTML = '';
    modal.classList.add('cf-open');
  }

  async function loadReviews() {
    const response = await fetch('/api/account/reviews', { credentials: 'same-origin' });
    const data = await response.json();
    if (!response.ok || !data.success) throw new Error(data.message || 'خطا در دریافت رضایت‌ها');
    const cards = [];
    for (const order of data.eligible || []) {
      for (const item of order.items || []) cards.push({ ...item, orderNumber: order.orderNumber });
    }
    countBox.textContent = new Intl.NumberFormat('fa-IR').format(cards.filter(item => !item.review || item.review.status === 'rejected').length);
    eligibleBox.innerHTML = cards.length ? cards.map(item => {
      const review = item.review;
      const canSend = !review || review.status === 'rejected';
      return `<article class="cf-feedback-card"><div class="cf-feedback-card-head">${item.image ? `<img src="${esc(item.image)}" alt="">` : ''}<div><h4>${esc(item.title)}</h4><p>سفارش ${esc(item.orderNumber)}</p><p>${esc([item.size,item.fabric].filter(Boolean).join(' • '))}</p></div></div><div class="cf-feedback-actions">${review ? `<span class="cf-feedback-status ${esc(review.status)}">${esc(statusLabel(review.status))}</span>` : '<span class="cf-feedback-status">هنوز نظری ثبت نشده</span>'}${canSend ? `<button class="portal-btn portal-btn-primary cf-review-open" type="button" data-order="${esc(item.orderNumber)}" data-product="${esc(item.productId)}">${review ? 'ارسال مجدد' : 'ثبت نظر و عکس'}</button>` : ''}</div></article>`;
    }).join('') : '<div class="empty-panel">فعلاً محصول تحویل‌شده‌ای برای ثبت نظر نداری.</div>';

    const itemMap = new Map(cards.map(item => [`${item.orderNumber}:${item.productId}`, item]));
    eligibleBox.querySelectorAll('.cf-review-open').forEach(button => button.addEventListener('click', () => {
      const item = itemMap.get(`${button.dataset.order}:${Number(button.dataset.product)}`);
      if (item) openModal(item, button.dataset.order);
    }));

    historyBox.innerHTML = (data.reviews || []).length ? data.reviews.map(review => `<article class="cf-feedback-card"><div><h4>${esc(review.productTitle)}</h4><p>${esc(review.text || 'بدون متن')}</p></div><div class="cf-feedback-actions"><span class="cf-feedback-status ${esc(review.status)}">${esc(statusLabel(review.status))}</span><small>${esc(review.orderNumber || '')}</small></div></article>`).join('') : '<div class="empty-panel">هنوز رضایتی ثبت نکرده‌ای.</div>';
  }

  document.getElementById('reviewModalClose')?.addEventListener('click', closeModal);
  document.getElementById('reviewModalCancel')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', event => { if (event.target === modal) closeModal(); });
  document.getElementById('reviewImages')?.addEventListener('change', event => {
    const files = [...event.target.files].slice(0,4);
    const preview = document.getElementById('reviewImagePreview');
    preview.innerHTML = '';
    files.forEach(file => { const img = document.createElement('img'); img.src = URL.createObjectURL(file); preview.appendChild(img); });
  });
  form?.addEventListener('submit', async event => {
    event.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const payload = new FormData();
      payload.append('orderNumber', document.getElementById('reviewOrderNumber').value);
      payload.append('productId', document.getElementById('reviewProductId').value);
      payload.append('text', document.getElementById('reviewText').value);
      [...document.getElementById('reviewImages').files].slice(0,4).forEach(file => payload.append('images', file));
      const response = await fetch('/api/account/reviews', { method:'POST', body:payload, credentials:'same-origin' });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || 'ثبت نظر انجام نشد');
      closeModal();
      alert(data.message || 'نظر ثبت شد');
      await loadReviews();
    } catch (error) { alert(error.message); } finally { button.disabled = false; }
  });

  loadReviews().catch(error => { if (eligibleBox) eligibleBox.innerHTML = `<div class="empty-panel">${esc(error.message)}</div>`; });
  const wantedOrder = new URLSearchParams(location.search).get('review');
  if (wantedOrder) {
    const button = document.querySelector('[data-account-view="reviews"]');
    setTimeout(() => button?.click(), 100);
  }
})();
</script>
</body>
</html>
