n value="زرین‌پال">زرین‌پال</option><option value="ترب‌پی">ترب‌پی</option><option value="اسنپ‌پی">اسنپ‌پی</option><option value="کارت به کارت">کارت به کارت</option><option value="درگاه آنلاین">درگاه آنلاین</option><option value="ثبت دستی مدیر">ثبت دستی مدیر</option><option value="ثبت نشده">ثبت نشده</option></select></div><div class="portal-table-wrap"><table class="portal-table"><thead><tr><th class="order-select-column"><input type="checkbox" class="order-select-checkbox" id="adminOrdersSelectAll" aria-label="انتخاب همه سفارش‌های نمایش‌داده‌شده"/></th><th class="order-row-number-column">ردیف</th><th>شماره سفارش</th><th>مشتری</th><th>تاریخ و ساعت ثبت</th><th>مبلغ</th><th>پرداخت / درگاه</th><th>منبع ورود</th><th>وضعیت</th><th>عملیات</th></tr></thead><tbody id="adminOrdersTable"></tbody></table></div></div>
</section>
