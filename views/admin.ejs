<script src="/assets/js/portal-data.js?v=20260827-home-attribution-v2"></script>
<script src="/assets/js/admin.js?v=20261008-snappay-v1"></script>
<script>
(() => {
  const list = document.getElementById('adminReviewsList');
  const filter = document.getElementById('adminReviewFilter');
  const pendingNav = document.getElementById('adminPendingReviews');
  const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
  const statusLabel = status => ({pending:'در انتظار تأیید',approved:'منتشر شده',rejected:'رد شده'}[status] || status);
  const reviewNavButton = document.querySelector('[data-admin-view="reviews"]');
  const activateReviewsView = () => {
    document.querySelectorAll('[data-admin-section]').forEach(section => section.classList.toggle('active', section.dataset.adminSection === 'reviews'));
    document.querySelectorAll('[data-admin-view]').forEach(button => button.classList.toggle('active', button.dataset.adminView === 'reviews'));
    const title = document.getElementById('adminViewTitle');
    if (title) title.textContent = 'رضایت مشتریان';
  };
  reviewNavButton?.addEventListener('click', activateReviewsView);

  async function request(url, options = {}) {
    const response = await fetch(url, { credentials:'same-origin', ...options });
    const data = await response.json();
    if (!response.ok || !data.success) throw new Error(data.message || 'عملیات انجام نشد');
    return data;
  }

  async function loadReviews() {
    const query = filter?.value ? `?status=${encodeURIComponent(filter.value)}` : '';
    const data = await request(`/api/admin/reviews${query}`);
    document.getElementById('reviewStatPending').textContent = new Intl.NumberFormat('fa-IR').format(data.counts.pending || 0);
    document.getElementById('reviewStatApproved').textContent = new Intl.NumberFormat('fa-IR').format(data.counts.approved || 0);
    document.getElementById('reviewStatRejected').textContent = new Intl.NumberFormat('fa-IR').format(data.counts.rejected || 0);
    if (pendingNav) pendingNav.textContent = new Intl.NumberFormat('fa-IR').format(data.counts.pending || 0);
    list.innerHTML = (data.reviews || []).length ? data.reviews.map(review => `<article class="cf-admin-review-card" data-id="${esc(review.id)}"><div class="cf-admin-review-head"><div><h4>${esc(review.customerName)}</h4><div class="cf-admin-review-meta">${esc(review.productTitle)}${review.orderNumber ? ` • سفارش ${esc(review.orderNumber)}` : ''} • ${esc(review.sourceLabel || '')}</div></div><span class="cf-review-pill ${esc(review.status)}">${esc(statusLabel(review.status))}</span></div>${review.text ? `<div class="cf-admin-review-text">${esc(review.text)}</div>` : ''}${review.images?.length ? `<div class="cf-admin-review-images">${review.images.map(img => `<a href="${esc(img.image)}" target="_blank" rel="noopener"><img src="${esc(img.thumbnail || img.image)}" alt=""></a>`).join('')}</div>` : ''}<div class="cf-admin-review-actions">${review.status !== 'approved' ? '<button class="portal-btn portal-btn-primary cf-review-approve" type="button">تأیید و انتشار</button>' : ''}${review.status !== 'rejected' ? '<button class="portal-btn portal-btn-light cf-review-reject" type="button">رد</button>' : ''}<button class="portal-btn portal-btn-light cf-review-delete" type="button">حذف</button>${review.productId ? `<a class="portal-btn portal-btn-soft" href="/product/${esc(review.productId)}#customer-reviews" target="_blank">محصول</a>` : '<a class="portal-btn portal-btn-soft" href="/reviews" target="_blank">صفحه رضایت‌ها</a>'}</div></article>`).join('') : '<div class="empty-panel">موردی در این وضعیت نیست.</div>';

    list.querySelectorAll('.cf-review-approve').forEach(btn => btn.addEventListener('click', async () => { const card=btn.closest('[data-id]'); await request(`/api/admin/reviews/${card.dataset.id}`, {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'approved'})}); await loadReviews(); }));
    list.querySelectorAll('.cf-review-reject').forEach(btn => btn.addEventListener('click', async () => { const card=btn.closest('[data-id]'); await request(`/api/admin/reviews/${card.dataset.id}`, {method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:'rejected'})}); await loadReviews(); }));
    list.querySelectorAll('.cf-review-delete').forEach(btn => btn.addEventListener('click', async () => { if(!confirm('این رضایت و تصاویرش حذف شود؟')) return; const card=btn.closest('[data-id]'); await request(`/api/admin/reviews/${card.dataset.id}`, {method:'DELETE'}); await loadReviews(); }));
  }

  document.getElementById('adminManualReviewForm')?.addEventListener('submit', async event => {
    event.preventDefault();
    const form = event.currentTarget;
    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;
    try {
      const payload = new FormData();
      payload.append('productId', document.getElementById('adminReviewProduct').value);
      payload.append('customerName', document.getElementById('adminReviewCustomer').value);
      payload.append('source', document.getElementById('adminReviewSource').value);
      payload.append('text', document.getElementById('adminReviewText').value);
      payload.append('status', document.getElementById('adminReviewInitialStatus').value);
      [...document.getElementById('adminReviewImages').files].slice(0,4).forEach(file => payload.append('images', file));
      const data = await request('/api/admin/reviews', {method:'POST',body:payload});
      alert(data.message || 'ثبت شد');
      form.reset();
      await loadReviews();
    } catch (error) { alert(error.message); } finally { button.disabled = false; }
  });

  filter?.addEventListener('change', () => loadReviews().catch(error => alert(error.message)));
  document.getElementById('refreshReviewsBtn')?.addEventListener('click', () => loadReviews().catch(error => alert(error.message)));
  document.querySelector('[data-admin-view="reviews"]')?.addEventListener('click', () => loadReviews().catch(error => alert(error.message)));
  loadReviews().catch(error => { if (list) list.innerHTML = `<div class="empty-panel">${esc(error.message)}</div>`; });
})();
</script>
</body>
</html>
