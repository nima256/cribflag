<script src="/assets/js/app.js"></script>
<script>
(() => {
  const provinceSelect = document.getElementById('checkoutProvince');
  const citySelect = document.getElementById('checkoutCity');

  if (!provinceSelect || !citySelect) return;

  provinceSelect.addEventListener('change', () => {
    const selected = provinceSelect.options[provinceSelect.selectedIndex];
    let cities = [];

    try {
      cities = JSON.parse(selected?.dataset?.cities || '[]');
    } catch {
      cities = [];
    }

    citySelect.innerHTML = '<option value="">انتخاب شهر</option>';

    cities.forEach(city => {
      const option = document.createElement('option');
      option.value = city;
      option.textContent = city;
      citySelect.appendChild(option);
    });

    citySelect.disabled = cities.length === 0;
  });
})();
</script>
