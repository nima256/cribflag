<main class="main"><section class="page active" id="page-checkout"><div class="container">
<div class="page-hero checkout-hero"><span class="eyebrow">ثبت نهایی سفارش</span><h1>تسویه حساب مرحله‌ای</h1><p>ابتدا اطلاعات تحویل، سپس روش ارسال و پرداخت، و در پایان خلاصه سبد را بررسی کنید.</p></div>
<div aria-label="مراحل تسویه" class="checkout-stepper"><div class="checkout-step-indicator active" data-indicator="1"><b>۱</b><span>اطلاعات</span></div><i></i><div class="checkout-step-indicator" data-indicator="2"><b>۲</b><span>ارسال و پرداخت</span></div><i></i><div class="checkout-step-indicator" data-indicator="3"><b>۳</b><span>بازبینی سفارش</span></div></div>
<form id="checkoutForm" novalidate="">
<section class="checkout-step active" data-step="1">
  <div class="checkout-stage-card">
    <div class="stage-heading">
      <span>مرحله اول</span>
      <h2>اطلاعات گیرنده و آدرس</h2>
    </div>

    <div class="checkout-grid">
      <div class="checkout-field">
        <label for="checkoutName">نام و نام خانوادگی</label>
        <input
          id="checkoutName"
          name="customer"
          value="<%= user?.fullName || '' %>"
          readonly
          aria-readonly="true"
          required
        />
      </div>

      <div class="checkout-field">
        <label for="checkoutPhone">شماره موبایل</label>
        <input
          id="checkoutPhone"
          name="phone"
          value="<%= user?.mobile || '' %>"
          inputmode="tel"
          dir="ltr"
          readonly
          aria-readonly="true"
          required
        />
      </div>

      <div class="checkout-field full">
        <label for="checkoutEmail">ایمیل</label>
        <input
          id="checkoutEmail"
          name="email"
          type="email"
          value="<%= user?.email || '' %>"
          dir="ltr"
          readonly
          aria-readonly="true"
        />
      </div>

      <div class="checkout-field">
        <label for="checkoutProvince">استان</label>
        <select id="checkoutProvince" name="province" required>
          <option value="">انتخاب استان</option>
          <% (provinces || []).forEach(province => { %>
            <option
              value="<%= province.name %>"
              data-cities='<%- safeJson(province.cities || []) %>'
            ><%= province.name %></option>
          <% }) %>
        </select>
      </div>

      <div class="checkout-field">
        <label for="checkoutCity">شهر</label>
        <select id="checkoutCity" name="city" required disabled>
          <option value="">ابتدا استان را انتخاب کنید</option>
        </select>
      </div>

      <div class="checkout-field">
        <label for="checkoutPostal">کد پستی</label>
        <input
          id="checkoutPostal"
          name="postalCode"
          inputmode="numeric"
          maxlength="10"
          placeholder="کد پستی ۱۰ رقمی"
          required
        />
      </div>

      <div class="checkout-field">
        <label for="checkoutUnit">پلاک / واحد</label>
        <input id="checkoutUnit" name="unit" placeholder="پلاک و واحد" required />
      </div>

      <div class="checkout-field full">
        <label for="checkoutAddress">آدرس دقیق</label>
        <textarea
          id="checkoutAddress"
          name="addressLine"
          placeholder="محله، خیابان، کوچه، پلاک، طبقه و واحد"
          minlength="10"
          required
        ></textarea>
      </div>

      <div class="checkout-field full">
        <label for="checkoutNote">توضیحات سفارش (اختیاری)</label>
        <textarea id="checkoutNote" name="note" placeholder="نکته‌ای درباره تحویل یا سفارش دارید؟"></textarea>
      </div>
    </div>

    <div class="checkout-actions">
      <a class="btn btn-ghost" href="/cart">بازگشت به سبد</a>
      <button class="btn btn-primary checkout-next" data-next="2" type="button">ادامه به ارسال و پرداخت</button>
    </div>
  </div>
</section>
<section class="checkout-step" data-step="2"><div class="checkout-stage-card"><div class="stage-heading"><span>مرحله دوم</span><h2>روش ارسال و پرداخت</h2></div><h3 class="choice-title">روش ارسال</h3><div class="shipping-options"><label class="option-card"><input checked="" data-shipping-price="0" name="shipping" type="radio" value="tipax"/><span><strong>ارسال با تیپاکس</strong><small>ارسال به سراسر ایران؛ هزینه هنگام تحویل دریافت می‌شود</small></span><b>پس‌کرایه</b></label><label class="option-card"><input data-shipping-price="0" name="shipping" type="radio" value="snapp"/><span><strong>ارسال فوری از کرج</strong><small>هزینه ارسال مستقیماً توسط مشتری پرداخت می‌شود</small></span><b>پرداخت جداگانه</b></label></div><h3 class="choice-title">روش پرداخت</h3><div class="payment-options"><label class="option-card"><input checked="" name="payment" type="radio" value="zarinpal"/><span><strong>پرداخت آنلاین</strong><small>اتصال به درگاه بانکی امن</small></span><b>پیشنهادی</b></label><label class="option-card"><input name="payment" type="radio" value="manual"/><span><strong>کارت به کارت</strong><small>مناسب سفارش‌های عمده با هماهنگی</small></span><b>هماهنگی</b></label></div><div class="checkout-actions"><button class="btn btn-ghost checkout-back" data-back="1" type="button">مرحله قبل</button><button class="btn btn-primary checkout-next" data-next="3" type="button">مشاهده و بازبینی سفارش</button></div></div></section>
<section class="checkout-step" data-step="3"><div class="checkout-review-layout"><div class="checkout-stage-card"><div class="stage-heading"><span>مرحله سوم</span><h2>سبد خرید و اطلاعات سفارش</h2></div><div class="checkout-review-items" id="checkoutSummaryItems"></div><div class="review-customer" id="checkoutCustomerReview"></div><div class="checkout-actions"><button class="btn btn-ghost checkout-back" data-back="2" type="button">مرحله قبل</button></div></div><aside class="checkout-summary final-summary"><h3>جمع سفارش</h3><div class="discount-row"><input id="discountCodeInput" placeholder="کد تخفیف"/><button id="applyDiscountBtn" type="button">اعمال</button></div><div class="discount-feedback" id="discountFeedback" aria-live="polite">هنوز کد تخفیفی اعمال نشده است.</div><div class="summary-line"><span>جمع محصولات</span><strong id="checkoutSubtotal">۰ تومان</strong></div><div class="summary-line"><span>تخفیف</span><strong id="checkoutDiscount">۰ تومان</strong></div><div class="summary-line"><span>هزینه ارسال</span><strong id="checkoutShipping">پرداخت جداگانه</strong></div><div class="summary-line total"><span>مبلغ نهایی</span><strong id="checkoutTotal">۰ تومان</strong></div><button class="btn btn-primary" id="finalPaymentBtn" type="button">تأیید و پرداخت نهایی</button><small class="secure-note">با ثبت پرداخت، سفارش برای بررسی و چاپ ارسال می‌شود.</small></aside></div></section>
</form></div></section></main>
