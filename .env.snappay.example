# ---------------------------------------------------------------------------
# SnappPay (اسنپ‌پی) for Crib Flag — copy into the server's .env (never commit .env).
# Crib Flag needs its OWN SnappPay merchant credentials (the ones in odour-stage.txt
# belong to the Odour merchant).
# ---------------------------------------------------------------------------
# Staging: https://fms-gateway-staging.apps.public.okd4.teh-1.snappcloud.io
SNAPPPAY_BASE_URL=
SNAPPPAY_CLIENT_ID=
SNAPPPAY_CLIENT_SECRET=
SNAPPPAY_USERNAME=
SNAPPPAY_PASSWORD=

# Public HTTPS address; callback = ${SITE_URL}/api/orders/snappay/callback
# SITE_URL=https://cribflag.ir

# Optional (defaults shown)
# SNAPPPAY_TIMEOUT_MS=30000
# SNAPPPAY_PAYMENT_METHOD_TYPE_DTO=INSTALLMENT
# SNAPPPAY_RECONCILE_INTERVAL_MINUTES=5
# SNAPPPAY_RECONCILE_MIN_AGE_MINUTES=15
# SNAPPPAY_PENDING_EXPIRE_MINUTES=60
# SNAPPPAY_STALE_LOCK_MINUTES=10
